+/* HIG §§3/4/8: balance this fixed caption after resolving the signed
+ * font, and measure both lines against the narrower circle chord. */
+static lv_obj_t *reminder_voice_hint(orb_time_view_t *v)
+{
+    bool ax = v->size == ORB_CONTENT_SIZE_AX3;
+    char value[80] = "Set by voice: “remind me at 6:30…”";
+    lv_obj_t *hint = text(v->content, ax ? "Set by voice" : value,
+                          233, 388, ax ? 200 : 230, ORB_TEXT_FOOTNOTE2, 0);
+    if (ax) return hint;
+    const lv_font_t *font = lv_obj_get_style_text_font(hint, 0);
+    int tracking = lv_obj_get_style_text_letter_space(hint, 0);
+    int height = 2 * font->line_height + lv_obj_get_style_text_line_space(hint, 0);
+    int width = orb_chord_width(388 - height / 2, 388 + (height + 1) / 2 - 1,
+                                ORB_RIM_MARGIN_TEXT);
+    unsigned best = 0;
+    int score = LV_COORD_MAX;
+    for (unsigned i = 0; value[i]; i++) {
+        if (value[i] != ' ') continue;
+        value[i] = '\0';
+        lv_point_t first, second;
+        lv_text_get_size(&first, value, font, tracking, 0, LV_COORD_MAX, LV_TEXT_FLAG_NONE);
+        lv_text_get_size(&second, value + i + 1, font, tracking, 0, LV_COORD_MAX, LV_TEXT_FLAG_NONE);
+        value[i] = ' ';
+        int difference = abs(first.x - second.x);
+        if (first.x <= width && second.x <= width && difference < score) {
+            best = i; score = difference;
+        }
+    }
+    if (best) value[best] = '\n';
+    lv_label_set_text(hint, best ? value : "Set by voice");
+    lv_obj_set_width(hint, width);
+    lv_obj_update_layout(hint);
+    lv_obj_set_pos(hint, 233 - width / 2, 388 - lv_obj_get_height(hint) / 2);
+    return hint;
 }
 
