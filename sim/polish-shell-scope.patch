+/* Keep cached scroll frames cheap: reflow native widths only at rest.
+ * The existing round-list helper owns chord transforms while dragging. */
+static void rooms_rows_layout(lv_obj_t *list)
+{
+    lv_obj_update_layout(list);
+    lv_area_t viewport;
+    lv_obj_get_coords(list, &viewport);
+    for (unsigned i = 0; i < lv_obj_get_child_count(list); i++) {
+        lv_obj_t *row = lv_obj_get_child(list, i);
+        if (lv_obj_get_child_count(row) != 2) continue;
+        lv_area_t bounds;
+        lv_obj_get_coords(row, &bounds);
+        int height = lv_obj_get_height(row);
+        int cy = LV_CLAMP(viewport.y1 + height / 2,
+                          (bounds.y1 + bounds.y2) / 2,
+                          viewport.y2 - (height + 1) / 2);
+        int width = height + orb_chord_width(cy, cy,
+            ORB_RIM_MARGIN_GLASS + (height + 1) / 2);
+        lv_obj_t *name = lv_obj_get_child(row, 0), *value = lv_obj_get_child(row, 1);
+        lv_obj_set_size(row, width, height);
+        lv_obj_set_x(row, (ORB_SCREEN_D - width) / 2);
+        lv_obj_set_width(name, LV_MAX(16, width - 44 - lv_obj_get_width(value) - 12));
+        lv_obj_set_x(value, width - 22 - lv_obj_get_width(value));
+    }
+    orb_round_list_update(list);
+}
+
+static void rooms_rows_settled(lv_event_t *event)
+{
+    rooms_rows_layout(lv_event_get_target_obj(event));
 }
 
